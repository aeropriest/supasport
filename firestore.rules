rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@supasport.com';
    }
    
    // Helper function to check if user is a coach
    function isCoach() {
      return request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    
    // Coaches collection
    match /coaches/{coachId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == coachId);
      allow write: if isAdmin();
    }
    
    // Clients collection
    match /clients/{clientId} {
      allow read: if isAdmin() || isCoach();
      allow write: if isAdmin();
    }
    
    // Packages collection
    match /packages/{packageId} {
      allow read: if isAdmin() || isCoach();
      allow write: if isAdmin() || isCoach();
    }
    
    // Lessons collection
    match /lessons/{lessonId} {
      allow read: if isAdmin() || isCoach();
      allow create: if isAdmin() || isCoach();
      allow update: if isAdmin() || (isCoach() && (resource.data.coachId == request.auth.uid || request.resource.data.coachId == request.auth.uid));
      allow delete: if isAdmin();
    }
  }
}
